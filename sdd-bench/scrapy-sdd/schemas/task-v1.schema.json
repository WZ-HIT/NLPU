{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-bench.local/schemas/task-v1.schema.json",
  "title": "SDD Bench agent-visible task v1",
  "$comment": "Agent-visible public task fields only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "repository", "pr_id", "baseline", "title", "body", "adapter"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name"],
      "properties": {
        "owner": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
      }
    },
    "pr_id": {"type": "integer", "minimum": 1},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha"],
      "properties": {"base_sha": {"$ref": "#/$defs/gitSha"}}
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 2000},
    "body": {"type": "string", "maxLength": 20000},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path", "sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "version": {"const": 1},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"}
  }
}
