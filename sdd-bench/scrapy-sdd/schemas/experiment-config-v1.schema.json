{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-bench.local/schemas/experiment-config-v1.schema.json",
  "title": "Concise SDD experiment config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "source_batch", "prs", "methods", "stages", "update_modes", "evaluation"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"$ref": "#/$defs/id"},
    "source_batch": {"$ref": "#/$defs/artifact"},
    "prs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["openspec", "speckit", "cc-sdd"]}},
    "stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["detect", "update"]}},
    "update_modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["sealed-detect", "self-directed"]}},
    "evaluation": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "none"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "plan"], "properties": {"kind": {"const": "host-plan"}, "plan": {"$ref": "#/$defs/artifact"}}}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"stages": {"contains": {"const": "update"}}}}, "then": {"properties": {"stages": {"contains": {"const": "detect"}}, "update_modes": {"minItems": 1}}}},
    {"if": {"properties": {"stages": {"not": {"contains": {"const": "update"}}}}}, "then": {"properties": {"update_modes": {"maxItems": 0}}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
