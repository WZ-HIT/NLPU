{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-bench.local/schemas/batch-evidence-manifest-v1.schema.json",
  "title": "Batch final evidence commitments v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_type", "batch_id", "source_files", "source_file_count", "source_files_sha256", "output_files", "output_file_count", "output_files_sha256", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_type": {"const": "BATCH_FINAL_EVIDENCE_MANIFEST"},
    "batch_id": {"$ref": "#/$defs/id"},
    "source_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "source_file_count": {"type": "integer", "minimum": 1},
    "source_files_sha256": {"$ref": "#/$defs/sha256"},
    "output_files": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/file"}, {"properties": {"path": {"pattern": "/final/report\\.json$"}}}]},
        {"allOf": [{"$ref": "#/$defs/file"}, {"properties": {"path": {"pattern": "/final/audit\\.json$"}}}]}
      ]
    },
    "output_file_count": {"const": 2},
    "output_files_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
