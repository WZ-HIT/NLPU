{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-bench.local/schemas/checkpoint-pr-v1.schema.json",
  "title": "SDD Bench per-task batch checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "checkpoint_type", "checkpoint_id", "created_at_utc", "contains_api_secret", "content_sha256", "task_id", "pr_id", "base_sha", "methods", "gold_store_sha256", "excluded_regenerable", "covered_targets", "payloads"],
  "properties": {
    "schema_version": {"const": 1},
    "checkpoint_type": {"const": "PR"},
    "checkpoint_id": {"type": "string", "pattern": "^pr-scrapy__scrapy__[A-Za-z0-9._-]+-[0-9]{8}T[0-9]{6}Z$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "contains_api_secret": {"const": false},
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "task_id": {"type": "string", "pattern": "^scrapy__scrapy__[A-Za-z0-9._-]+$"},
    "pr_id": {"type": "integer", "minimum": 1},
    "base_sha": {"$ref": "#/$defs/gitSha"},
    "methods": {"type": "object", "additionalProperties": {"$ref": "#/$defs/method"}},
    "gold_store_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "excluded_regenerable": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "reason", "file_count", "size_bytes", "assertion"], "properties": {
      "path": {"$ref": "#/$defs/path"},
      "reason": {"enum": ["git-metadata", "detect-workspace", "update-workspace"]},
      "file_count": {"type": "integer", "minimum": 0},
      "size_bytes": {"type": "integer", "minimum": 0},
      "assertion": {"type": "string", "minLength": 1}
    }}},
    "covered_targets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["batch_id", "method", "stage", "run_id", "update_mode", "state", "attempt"], "properties": {
      "batch_id": {"type": "string", "minLength": 1},
      "method": {"enum": ["openspec", "speckit", "cc-sdd"]},
      "stage": {"enum": ["detect", "update"]},
      "run_id": {"type": "string", "minLength": 1},
      "update_mode": {"oneOf": [{"enum": ["sealed-detect", "self-directed"]}, {"type": "null"}]},
      "state": {"type": "string", "minLength": 1},
      "attempt": {"type": "integer", "minimum": 1}
    }}},
    "payloads": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/payload"}}
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"},
    "method": {"type": "object", "additionalProperties": false, "required": ["detect_run_ids", "update_runs", "sealed_input_detection_manifest_sha256", "sealed_input_planning_manifest_sha256", "detect_planning_manifest_sha256", "initialization_manifest_sha256", "initialization_file_count"], "properties": {
      "detect_run_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "update_runs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["run_id", "mode"], "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["sealed-detect", "self-directed"]}
      }}},
      "sealed_input_detection_manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
      "sealed_input_planning_manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
      "detect_planning_manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
      "initialization_manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
      "initialization_file_count": {"type": "integer", "minimum": 0}
    }},
    "payload": {"type": "object", "additionalProperties": false, "required": ["name", "install_path", "sha256", "size_bytes", "member_count", "file_manifest_sha256"], "properties": {
      "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.tar(\\.gz)?$"},
      "install_path": {"$ref": "#/$defs/path"},
      "kind": {"const": "tree"},
      "sha256": {"$ref": "#/$defs/sha256"},
      "size_bytes": {"type": "integer", "minimum": 1},
      "member_count": {"type": "integer", "minimum": 0},
      "file_manifest_sha256": {"$ref": "#/$defs/sha256"}
    }}
  }
}
