{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-bench.local/schemas/batch-run-v1.schema.json",
  "title": "SDD Detect-Update batch run configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "approved_plan", "tasks"],
  "properties": {
    "schema_version": {"const": 1},
    "batch_id": {"$ref": "#/$defs/id"},
    "approved_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "path", "sha256", "provision_report_path", "provision_report_sha256"],
      "properties": {
        "plan_id": {"$ref": "#/$defs/id"},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "provision_report_path": {"$ref": "#/$defs/path"},
        "provision_report_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tasks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "task_manifest", "methods"],
        "properties": {
          "task_id": {"$ref": "#/$defs/id"},
          "task_manifest": {"$ref": "#/$defs/artifact"},
          "methods": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["method", "detect", "updates"],
              "properties": {
                "method": {"enum": ["openspec", "speckit", "cc-sdd"]},
                "detect": {
                  "type": "object", "additionalProperties": false,
                  "required": ["run_id"],
                  "properties": {"run_id": {"$ref": "#/$defs/id"}}
                },
                "updates": {
                  "type": "array",
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["run_id", "mode", "policy"],
                    "properties": {
                      "run_id": {"$ref": "#/$defs/id"},
                      "mode": {"enum": ["sealed-detect", "self-directed"]},
                      "policy": {"$ref": "#/$defs/artifact"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"},
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
