{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-bench.local/schemas/batch-final-audit-v1.schema.json",
  "title": "Deterministic batch final audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_type", "batch_id", "status", "checks", "ledger", "barrier_sha256", "targets", "limitations", "disclosures", "report_sha256", "audit_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "audit_type": {"const": "BATCH_FINAL_AUDIT"},
    "batch_id": {"$ref": "#/$defs/id"},
    "status": {"const": "PASS_WITH_LIMITATIONS"},
    "checks": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/check"}},
    "ledger": {
      "type": "object", "additionalProperties": false,
      "required": ["event_count", "sha256", "chain_tip_sha256"],
      "properties": {"event_count": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "chain_tip_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "barrier_sha256": {"$ref": "#/$defs/sha256"},
    "targets": {"type": "array", "minItems": 27, "maxItems": 27, "items": {"$ref": "#/$defs/target"}},
    "limitations": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "disclosures": {"type": "object"},
    "report_sha256": {"$ref": "#/$defs/sha256"},
    "audit_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "check": {
      "type": "object", "additionalProperties": false, "required": ["id", "status"],
      "properties": {"id": {"type": "string", "minLength": 1}, "status": {"enum": ["PASS", "LIMITATION"]}}
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["target", "stage", "status", "checks"],
      "properties": {
        "target": {"$ref": "#/$defs/id"}, "stage": {"enum": ["detect", "update"]}, "status": {"const": "PASS"},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}
      }
    }
  }
}
