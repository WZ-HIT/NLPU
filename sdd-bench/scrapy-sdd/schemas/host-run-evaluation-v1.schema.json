{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-bench.local/schemas/host-run-evaluation-v1.schema.json",
  "title": "Host run evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "evaluation_id", "target_id", "target_key_sha256", "stage", "task_id", "classification", "method", "run_id", "update_mode", "metric_definition_version", "validity", "policy_compliance", "model_performance", "handoff", "execution", "attribution", "provenance", "evaluation_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "artifact_type": {"const": "HOST_RUN_EVALUATION"},
    "evaluation_id": {"$ref": "#/$defs/id"}, "target_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"}, "target_key_sha256": {"$ref": "#/$defs/sha256"},
    "stage": {"enum": ["detect", "update"]}, "task_id": {"$ref": "#/$defs/id"}, "classification": {"enum": ["TEST_ONLY_PR", "MIXED_CODE_AND_TEST_PR"]}, "method": {"enum": ["openspec", "speckit", "cc-sdd"]}, "run_id": {"$ref": "#/$defs/id"}, "update_mode": {"type": ["string", "null"], "enum": [null, "sealed-detect", "self-directed"]}, "metric_definition_version": {"const": "prompt10-metrics-v1"},
    "validity": {"type": "object", "additionalProperties": false, "required": ["status", "reason_ids"], "properties": {"status": {"enum": ["VALID", "INVALID"]}, "reason_ids": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}}}},
    "policy_compliance": {"type": "object", "additionalProperties": false, "required": ["status", "compliant", "scope_violation_count", "sealed_candidate_subset", "performance_advantage_inferred"], "properties": {"status": {"enum": ["NOT_APPLICABLE", "COMPLIANT", "NON_COMPLIANT"]}, "compliant": {"type": "boolean"}, "scope_violation_count": {"type": "integer", "minimum": 0}, "sealed_candidate_subset": {"type": "boolean"}, "performance_advantage_inferred": {"const": false}}},
    "model_performance": {"type": "object", "additionalProperties": false, "required": ["file", "symbol"], "properties": {"file": {"$ref": "#/$defs/metrics"}, "symbol": {"$ref": "#/$defs/metrics"}}},
    "handoff": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["causal", "interpretation", "detect_candidate_count", "update_file_count", "overlap_count", "update_within_detect_rate"], "properties": {"causal": {"type": "boolean"}, "interpretation": {"enum": ["causal-handoff", "post-hoc-non-causal-overlap"]}, "detect_candidate_count": {"type": "integer", "minimum": 0}, "update_file_count": {"type": "integer", "minimum": 0}, "overlap_count": {"type": "integer", "minimum": 0}, "update_within_detect_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}}]},
    "execution": {"type": "object", "additionalProperties": false, "required": ["behavior_path", "behavior_sha256", "resource_profile_sha256", "project_tests_run_by_agent", "project_tests_run_by_host"], "properties": {"behavior_path": {"type": ["string", "null"]}, "behavior_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "resource_profile_sha256": {"$ref": "#/$defs/sha256"}, "project_tests_run_by_agent": {"const": false}, "project_tests_run_by_host": {"type": "boolean"}}},
    "attribution": {"type": "object", "additionalProperties": false, "required": ["precedence", "result"], "properties": {"precedence": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/attribution"}}, "result": {"$ref": "#/$defs/attribution"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["base_sha", "gold_seal_sha256", "sealed_artifact_sha256", "ledger_sha256", "detect_barrier_sha256"], "properties": {"base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "gold_seal_sha256": {"$ref": "#/$defs/sha256"}, "sealed_artifact_sha256": {"$ref": "#/$defs/sha256"}, "ledger_sha256": {"$ref": "#/$defs/sha256"}, "detect_barrier_sha256": {"$ref": "#/$defs/sha256"}}},
    "evaluation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attribution": {"enum": ["invalid_evidence", "infrastructure_failure", "policy_violation", "localization_miss", "update_selection_miss", "patch_application_failure", "functional_failure", "success"]},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["metric_definition_version", "gold_count", "predicted_count", "matched_count", "tp", "fp", "fn", "precision", "recall", "f1", "exact_match", "any_hit", "all_hit", "hit_at_1", "recall_at_1", "hit_at_3", "recall_at_3", "hit_at_5", "recall_at_5", "mrr", "gold_to_predicted_ratio", "invalid_count", "missing_count", "scorable_count"], "properties": {"metric_definition_version": {"const": "prompt10-metrics-v1"}, "gold_count": {"type": "integer", "minimum": 0}, "predicted_count": {"type": "integer", "minimum": 0}, "matched_count": {"type": "integer", "minimum": 0}, "tp": {"type": "integer", "minimum": 0}, "fp": {"type": "integer", "minimum": 0}, "fn": {"type": "integer", "minimum": 0}, "precision": {"$ref": "#/$defs/rate"}, "recall": {"$ref": "#/$defs/rate"}, "f1": {"$ref": "#/$defs/rate"}, "exact_match": {"type": "integer", "minimum": 0, "maximum": 1}, "any_hit": {"type": "integer", "minimum": 0, "maximum": 1}, "all_hit": {"type": "integer", "minimum": 0, "maximum": 1}, "hit_at_1": {"type": "integer", "minimum": 0, "maximum": 1}, "recall_at_1": {"$ref": "#/$defs/rate"}, "hit_at_3": {"type": "integer", "minimum": 0, "maximum": 1}, "recall_at_3": {"$ref": "#/$defs/rate"}, "hit_at_5": {"type": "integer", "minimum": 0, "maximum": 1}, "recall_at_5": {"$ref": "#/$defs/rate"}, "mrr": {"$ref": "#/$defs/rate"}, "gold_to_predicted_ratio": {"type": ["number", "null"], "minimum": 0}, "invalid_count": {"type": "integer", "minimum": 0}, "missing_count": {"type": "integer", "minimum": 0}, "scorable_count": {"type": "integer", "minimum": 0}}}
  }
}
