{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-bench.local/schemas/prepared-manifest-v1.schema.json",
  "title": "Prepared SDD experiment manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_type", "experiment_id", "prepared_id", "inputs", "target_count", "targets"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_type": {"const": "PREPARED_EXPERIMENT"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "prepared_id": {"type": "string", "pattern": "^prepared-[0-9a-f]{24}$"},
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["user_config", "source_batch", "batch_id", "approved_plan", "evaluation"],
      "properties": {
        "user_config": {"$ref": "#/$defs/artifact"},
        "source_batch": {"$ref": "#/$defs/artifact"},
        "batch_id": {"$ref": "#/$defs/id"},
        "approved_plan": {
          "type": "object", "additionalProperties": false,
          "required": ["plan_id", "path", "sha256", "provision_report_path", "provision_report_sha256"],
          "properties": {
            "plan_id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"},
            "provision_report_path": {"$ref": "#/$defs/path"}, "provision_report_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "evaluation": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "none"}}},
          {"type": "object", "additionalProperties": false, "required": ["kind", "plan"], "properties": {"kind": {"const": "host-plan"}, "plan": {"$ref": "#/$defs/artifact"}}}
        ]}
      }
    },
    "target_count": {"type": "integer", "minimum": 1},
    "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "task_id", "method", "stage", "mode", "run_id", "base_sha", "task_manifest", "policy"],
      "properties": {
        "target_id": {"type": "string", "pattern": "^target-[0-9a-f]{24}$"},
        "task_id": {"$ref": "#/$defs/id"}, "method": {"enum": ["openspec", "speckit", "cc-sdd"]},
        "stage": {"enum": ["detect", "update"]}, "mode": {"type": ["string", "null"], "enum": [null, "sealed-detect", "self-directed"]},
        "run_id": {"$ref": "#/$defs/id"}, "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "task_manifest": {"$ref": "#/$defs/artifact"}, "policy": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]}
      },
      "allOf": [
        {"if": {"properties": {"stage": {"const": "detect"}}}, "then": {"properties": {"mode": {"type": "null"}, "policy": {"type": "null"}}}},
        {"if": {"properties": {"stage": {"const": "update"}}}, "then": {"properties": {"mode": {"enum": ["sealed-detect", "self-directed"]}, "policy": {"$ref": "#/$defs/artifact"}}}}
      ]
    }
  }
}
