{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-bench.local/schemas/host-evaluation-manifest-v1.schema.json",
  "title": "Host evaluation evidence manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "evaluation_id", "batch_id", "source_commitments", "output_file_count", "output_files", "output_files_sha256", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "artifact_type": {"const": "HOST_EVALUATION_EVIDENCE_MANIFEST"}, "evaluation_id": {"$ref": "#/$defs/id"}, "batch_id": {"$ref": "#/$defs/id"},
    "source_commitments": {"type": "object", "additionalProperties": false, "required": ["evaluation_plan_sha256", "batch_config_sha256", "ledger_sha256", "detect_barrier_sha256", "gold_seal_sha256", "raw_source_sha256"], "properties": {"evaluation_plan_sha256": {"$ref": "#/$defs/sha256"}, "batch_config_sha256": {"$ref": "#/$defs/sha256"}, "ledger_sha256": {"$ref": "#/$defs/sha256"}, "detect_barrier_sha256": {"$ref": "#/$defs/sha256"}, "gold_seal_sha256": {"$ref": "#/$defs/sha256"}, "raw_source_sha256": {"$ref": "#/$defs/sha256"}}},
    "output_file_count": {"type": "integer", "minimum": 1}, "output_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}, "output_files_sha256": {"$ref": "#/$defs/sha256"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
