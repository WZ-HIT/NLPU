{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-bench.local/schemas/agent-token-usage-v1.schema.json",
  "title": "Provider token usage for one formal Agent attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "metric_definition_version",
    "status",
    "completed_turn_count",
    "invalid_event_count",
    "process_exit_code",
    "usage_sha256",
    "source",
    "input_tokens",
    "cached_input_tokens",
    "cache_write_input_tokens",
    "output_tokens",
    "reasoning_output_tokens",
    "total_tokens"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "document_type": {
      "const": "AGENT_TOKEN_USAGE"
    },
    "metric_definition_version": {
      "const": "agent-token-usage-v1"
    },
    "status": {
      "enum": [
        "RECORDED",
        "PARTIAL",
        "NOT_RECORDED",
        "UNREADABLE"
      ]
    },
    "completed_turn_count": {
      "type": "integer",
      "minimum": 0
    },
    "invalid_event_count": {
      "type": "integer",
      "minimum": 0
    },
    "process_exit_code": {
      "type": "integer"
    },
    "usage_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "const": "agent.jsonl"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "input_tokens": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "cached_input_tokens": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "cache_write_input_tokens": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "output_tokens": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "reasoning_output_tokens": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "total_tokens": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    }
  }
}
