{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-bench.local/schemas/experiment-config-v2.schema.json",
  "title": "Detect-only multi-source SDD experiment config v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "sources",
    "prs",
    "methods",
    "stages",
    "update_modes",
    "evaluation"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "experiment_id": {
      "$ref": "#/$defs/id"
    },
    "prs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "openspec",
          "speckit",
          "cc-sdd"
        ]
      }
    },
    "stages": {
      "const": [
        "detect"
      ]
    },
    "update_modes": {
      "const": []
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "detect-host"
        },
        "localization_protocol": {
          "const": "testcase-v1"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "test_intention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "artifacts"
      ],
      "properties": {
        "entrypoint": {
          "const": "test-intentions/README.md"
        },
        "artifacts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[0-9a-f]{40}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "dynamic_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "artifacts"
      ],
      "properties": {
        "entrypoint": {
          "const": "test-traces/README.md"
        },
        "artifacts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[0-9a-f]{40}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
