{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public Detect draft structure v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "symbols", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "symbols": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$comment": "Protocol-specific symbol cardinality and lexical paths are checked by contract.py. Identity checks are a separate layer; neither layer reads host labels."
}
