+@pytest.mark.parametrize(
+    ("content_type", "expected_extension"),
+    [
+        (b"text/plain", ".txt"),
+        (b"image/png", ".png"),
+        (b"image/gif", ".gif"),
+        (b"application/pdf", ".pdf"),
+        (b"application/zip", ".zip"),
+        (b"video/mp4", ".mp4"),
+    ],
+)
+def test_open_in_browser_non_text_response(
+    content_type: bytes, expected_extension: str
+) -> None:
+    """Non-text responses are opened using a file extension matching the media
+    type of their Content-Type header, so that browsers handle them properly."""
+    url = "http://www.example.com/some/file"
+    body = b"\x00\x01\x02binary\xff content"
+
+    def check(burl):
+        assert burl.endswith(expected_extension)
+        assert _read_browser_output(burl) == body
+        return True
+
+    response = Response(url, body=body, headers={"Content-Type": content_type})
+    assert open_in_browser(response, _openfunc=check), "Browser not called"
