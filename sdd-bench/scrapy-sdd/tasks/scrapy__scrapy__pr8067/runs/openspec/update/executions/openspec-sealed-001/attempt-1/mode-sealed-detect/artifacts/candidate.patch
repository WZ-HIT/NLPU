+@pytest.mark.parametrize(
+    ("content_type", "extension"),
+    [
+        (b"image/png", ".png"),
+        (b"application/pdf", ".pdf"),
+        (b"image/png; charset=binary", ".png"),
+    ],
+)
+def test_open_in_browser_non_text_response_uses_content_type_extension(
+    content_type: bytes, extension: str
+) -> None:
+    body = b"non-text body"
+    response = Response(
+        "http://www.example.com", body=body, headers={"Content-Type": content_type}
+    )
+
+    def check(burl):
+        assert burl.endswith(extension)
+        assert _read_browser_output(burl) == body
+        return True
+
+    assert open_in_browser(response, _openfunc=check)  # type: ignore[arg-type]
+
+
 def test_open_in_browser_raises_for_unsupported_response_type():
     response = Response("http://www.example.com", body=b"binary")
     with pytest.raises(TypeError):
         open_in_browser(response, _openfunc=lambda _: True)  # type: ignore[arg-type]
+
+
+def test_open_in_browser_raises_for_unknown_content_type():
+    response = Response(
+        "http://www.example.com",
+        body=b"binary",
+        headers={"Content-Type": b"application/x-unknown"},
+    )
+    with pytest.raises(TypeError):
+        open_in_browser(response, _openfunc=lambda _: True)  # type: ignore[arg-type]
