 def test_open_in_browser_redos_comment():
     # Exploit input from
     # https://makenowjust-labs.github.io/recheck/playground/
     # for /<!--.*?-->/ (old pattern to remove comments).
-    _assert_open_in_browser_is_fast(b"-><!--\x00" * 250_000 + b"->\n<!---->")
+    # The original input ended with "<!--" followed by "-->", which lets the
+    # pattern match from the first comment start when re.DOTALL is used. Keep
+    # the input free of a comment terminator instead to force the vulnerable
+    # pattern to scan to the end of the body at every comment-start candidate.
+    body = b"-><!--\x00" * 250_000 + b"->"
+    assert b"-->" not in body
+    _assert_open_in_browser_is_fast(body)
 
 
